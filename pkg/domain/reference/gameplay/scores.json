  "notes": [
    {
      "section": "功能介绍",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section19331230181011",
      "text": "华为游戏服务器调用此接口分页查询玩家在玩游戏的战绩数据，并将信息展示在游戏中心的“在玩”页面上。"
    },
    {
      "section": "请求参数",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section133671740131017",
      "text": "Header参数"
    },
    {
      "section": "响应参数",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section4102155161010",
      "text": "BattleRecordCard"
    },
    {
      "section": "响应参数",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section4102155161010",
      "text": "BattleRecordCardData"
    },
    {
      "section": "响应参数",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section4102155161010",
      "text": "BattleRecord"
    },
    {
      "section": "响应参数",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section4102155161010",
      "text": "GameResource"
    },
    {
      "section": "验签机制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section205561419163916",
      "text": "将Header参数中的appId、timestamp、nonce字段依次拼接成一个待验签的字符串。"
    },
    {
      "section": "验签机制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section205561419163916",
      "text": "对待验签字符串使用SHA256WithRSA/PSS算法进行签名。"
    },
    {
      "section": "验签机制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section205561419163916",
      "text": "将签名后的字符串经过Base64编码，得到的字符串与sign字段中的签名字符串进行一致性验证。 说明 游戏公钥在开通游戏服务后生成，查询方法参见查询游戏服务信息。"
    },
    {
      "section": "验签机制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section205561419163916",
      "text": "游戏公钥在开通游戏服务后生成，查询方法参见查询游戏服务信息。"
    },
    {
      "section": "验签机制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section205561419163916",
      "text": "Java示例代码如下："
    },
    {
      "section": "验签机制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section205561419163916",
      "text": "// 从Header中取出appId，timestamp，nonce，拼接成待签名的字符串"
    },
    {
      "section": "验签机制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section205561419163916",
      "text": "String rawStr = appId + timestamp + nonce;"
    },
    {
      "section": "验签机制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section205561419163916",
      "text": "// 获取验签公钥，具体实现方法由开发者自行决定，此处仅为接口示例"
    },
    {
      "section": "验签机制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section205561419163916",
      "text": "String publicKey = \"xxxxxxxxx\";"
    },
    {
      "section": "验签机制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section205561419163916",
      "text": "// 验签，BouncyCastleProvider的创建较耗费性能，建议写成单例"
    },
    {
      "section": "验签机制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section205561419163916",
      "text": "byte[] keyBytes = Base64.decodeBase64(publicKey.getBytes(StandardCharsets.UTF_8));"
    },
    {
      "section": "验签机制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section205561419163916",
      "text": "PKCS8EncodedKeySpec pkcs8KeySpec = new PKCS8EncodedKeySpec(keyBytes);"
    },
    {
      "section": "验签机制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section205561419163916",
      "text": "KeyFactory keyFactory = KeyFactory.getInstance(\"RSA\");"
    },
    {
      "section": "验签机制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section205561419163916",
      "text": "PublicKey publicK = keyFactory.generatePublic(pkcs8KeySpec);"
    },
    {
      "section": "验签机制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section205561419163916",
      "text": "Signature signature = Signature.getInstance(\"SHA256withRSA/PSS\", new BouncyCastleProvider());"
    },
    {
      "section": "验签机制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section205561419163916",
      "text": "signature.initVerify(key);"
    },
    {
      "section": "验签机制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section205561419163916",
      "text": "signature.update(rawStr.getBytes(StandardCharsets.UTF_8));"
    },
    {
      "section": "验签机制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-scores-0000001985465938#section205561419163916",
      "text": "signature.verify(Base64.decodeBase64(sign)); // sign是Header中的字段，即请求时传递的签名"
    }
  ],
