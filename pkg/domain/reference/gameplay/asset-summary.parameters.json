    "maxLength": 64
  },
  {
    "name": "sign",
    "in": "header",
    "type": "string",
    "required": true,
    "description": "华为服务器在发送请求时的签名字符串，生成步骤如下： 将Header参数中的appId、timestamp、nonce字段依次拼接成一个待签名的字符串。 对待签名字符串使用SHA256WithRSA/PSS算法进行签名。 将签名后的字符串经过Base64编码，得到的字符串即为签名字符串。 您需要获取验签公钥，并根据加密算法使用公钥对签名字符串进行验签，验签方法参见验签机制。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-asset-summary-0000002022105729#section133671740131017",
    "maxLength": 1024
  },
