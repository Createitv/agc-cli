  "notes": [
    {
      "section": "功能介绍",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/app/agc-help-domain-api-download-domain-config-0000002271160653#section16817111413112",
      "text": "此接口用于以文件流的形式进行直接下载域名配置文件。"
    },
    {
      "section": "功能介绍",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/app/agc-help-domain-api-download-domain-config-0000002271160653#section16817111413112",
      "text": "接口调用者的角色：账号持有者、管理员、APP管理员、运营。"
    },
    {
      "section": "服务器域名配置约束与限制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/app/agc-help-domain-api-download-domain-config-0000002271160653#section7163155161617",
      "text": "同一个元服务每个自然月服务器域名修改次数，默认为50次。"
    },
    {
      "section": "服务器域名配置约束与限制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/app/agc-help-domain-api-download-domain-config-0000002271160653#section7163155161617",
      "text": "单项服务器域名配置数量最多不超过200个。"
    },
    {
      "section": "服务器域名配置约束与限制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/app/agc-help-domain-api-download-domain-config-0000002271160653#section7163155161617",
      "text": "域名只支持HTTPS和WSS协议。"
    },
    {
      "section": "服务器域名配置约束与限制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/app/agc-help-domain-api-download-domain-config-0000002271160653#section7163155161617",
      "text": "域名不能使用IP地址或localhost。"
    },
    {
      "section": "服务器域名配置约束与限制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/app/agc-help-domain-api-download-domain-config-0000002271160653#section7163155161617",
      "text": "不可配置全局禁止清单内的域名。"
    },
    {
      "section": "业务域名配置约束与限制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/app/agc-help-domain-api-download-domain-config-0000002271160653#section5605815161218",
      "text": "同一个元服务每个自然月业务域名修改次数，默认为50次。"
    },
    {
      "section": "业务域名配置约束与限制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/app/agc-help-domain-api-download-domain-config-0000002271160653#section5605815161218",
      "text": "同一个APPID下，最多支持配置100个业务域名；同一个业务域名最多可配置100个APPID。"
    },
    {
      "section": "业务域名配置约束与限制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/app/agc-help-domain-api-download-domain-config-0000002271160653#section5605815161218",
      "text": "域名只支持HTTPS协议。"
    },
    {
      "section": "业务域名配置约束与限制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/app/agc-help-domain-api-download-domain-config-0000002271160653#section5605815161218",
      "text": "网页内iframe的域名也需要配置。"
    },
    {
