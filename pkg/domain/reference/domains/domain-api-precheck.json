  "notes": [
    {
      "section": "功能介绍",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/app/agc-help-domain-api-precheck-0000002295134522#section16817111413112",
      "text": "此接口用于对业务域名配置进行预检查。"
    },
    {
      "section": "功能介绍",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/app/agc-help-domain-api-precheck-0000002295134522#section16817111413112",
      "text": "接口调用者的角色：账号持有者、管理员、APP管理员、运营。"
    },
    {
      "section": "业务域名配置约束与限制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/app/agc-help-domain-api-precheck-0000002295134522#section5605815161218",
      "text": "同一个元服务每个自然月业务域名修改次数，默认为50次。"
    },
    {
      "section": "业务域名配置约束与限制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/app/agc-help-domain-api-precheck-0000002295134522#section5605815161218",
      "text": "同一个APPID下，最多支持配置100个业务域名；同一个业务域名最多可配置100个APPID。"
    },
    {
      "section": "业务域名配置约束与限制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/app/agc-help-domain-api-precheck-0000002295134522#section5605815161218",
      "text": "域名只支持HTTPS协议。"
    },
    {
      "section": "业务域名配置约束与限制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/app/agc-help-domain-api-precheck-0000002295134522#section5605815161218",
      "text": "域名不能使用IP地址或localhost。"
    },
    {
      "section": "业务域名配置约束与限制",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/app/agc-help-domain-api-precheck-0000002295134522#section5605815161218",
      "text": "网页内iframe的域名也需要配置。"
    },
    {
      "section": "请求参数",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/app/agc-help-domain-api-precheck-0000002295134522#section236517415165",
      "text": "本接口支持使用Service Account方式和API客户端方式，二者区别请参见获取服务端授权。"
    },
    {
      "section": "请求参数",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/app/agc-help-domain-api-precheck-0000002295134522#section236517415165",
      "text": "Service Account方式："
    },
    {
      "section": "请求参数",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/app/agc-help-domain-api-precheck-0000002295134522#section236517415165",
      "text": "API客户端方式："
    },
    {
      "section": "请求参数",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/app/agc-help-domain-api-precheck-0000002295134522#section141117691213",
      "text": "请求Body中使用JSON格式携带业务域名信息，参数如下表所示。"
    }
  ],
