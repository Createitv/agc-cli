      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-propapi-getroleinfo-0000002355255377#section189643201134",
      "text": "验签示例代码 JAVA package com.huawei.game.domain.develop.test; import org.apache.commons.codec.binary.Base64; import java.io.UnsupportedEncodingException; import java.net.URLEncoder; import java.nio.charset.StandardCharsets; import java.security.KeyFactory; import java.security.PublicKey; import java.security.Signature; import java.security.spec.X509EncodedKeySpec; import java.util.HashMap; import java.util.Map; import java.util.TreeMap; public class SecretVerifyTest { public static void main(String[] args) throws Exception { // 以下公钥和私钥为临时生成，以供展示代码示例，正式环境请替换 String publicKey = \"MIIBIjANBgkqh*****AB\"; String privateKey = \"MIIEvAIBADANB*****==\"; System.out.println(\"公钥：\" + publicKey); System.out.println(\"私钥：\" + privateKey); // 模拟入参 HashMap<String, String> reqMap = new HashMap<>(); // 验签步骤 // 1. 从请求中取出sign属性，注意：待验签的字符串不包含sign属性，此时需要从Map中取出。 String reqSign = reqMap.remove(\"sign\"); System.out.println(\"加签结果：\" + reqSign); // 2. 生成待验签的字符串。 String targetStr = buildSortedSignData(reqMap); System.out.println(\"加签的字符串：\" + targetStr); // 3. 进行验签，注意：此处验签的公钥需要修改为AGC管理台上的公钥。 boolean result = verify(targetStr.getBytes(StandardCharsets.UTF_8), publicKey, reqSign); System.out.println(\"验签结果为：\" + result); } /** * 生成待签名的字符串 * * @param params 入参 * @return 待签名的字符串 */ public static String buildSortedSignData(Map<String, String> params) throws UnsupportedEncodingException { StringBuilder targetParamStr = new StringBuilder(); Map<String, String> sortedParamMap = new TreeMap<>(params); for (Map.Entry<String, String> param : sortedParamMap.entrySet()) { String key = param.getKey(); String value = param.getValue(); targetParamStr.append(key) .append(\"=\") .append(null == value ? \"\" : URLEncoder.encode(value, \"UTF-8\")) .append(\"&\"); } return targetParamStr.substring(0, targetParamStr.toString().length() - 1); } /** * 验签结果 * * @param data 待验签的字符串 * @param publicKey 公钥 * @param sign 签名字符串 * @return 验签结果 */ public static boolean verify(byte[] data, String publicKey, String sign) throws Exception { byte[] keyBytes = Base64.decodeBase64(publicKey); X509EncodedKeySpec keySpec = new X509EncodedKeySpec(keyBytes); KeyFactory keyFactory = KeyFactory.getInstance(\"RSA\"); PublicKey publicK = keyFactory.generatePublic(keySpec); Signature signature = Signature.getInstance(\"SHA256WithRSA/PSS\"); signature.initVerify(publicK); signature.update(data); return signature.verify(Base64.decodeBase64(sign)); } }"
    },
