      "text": "验签测试代码 JAVA package com.huawei.game.domain.develop.test; import org.apache.commons.codec.binary.Base64; import java.io.UnsupportedEncodingException; import java.net.URLEncoder; import java.nio.charset.StandardCharsets; import java.security.KeyFactory; import java.security.PrivateKey; import java.security.Signature; import java.security.spec.PKCS8EncodedKeySpec; import java.util.HashMap; import java.util.Map; import java.util.TreeMap; public class SecretCreateSignTest { public static void main(String[] args) throws Exception { // 以下公钥和私钥为临时生成，以供展示代码示例，正式环境请替换 String publicKey = \"MIIBIjANBgkqh*****AB\"; String privateKey = \"MIIEvAIBADANB*****==\"; System.out.println(\"公钥：\" + publicKey); System.out.println(\"私钥：\" + privateKey); HashMap<String, String> reqMap = new HashMap<>(); reqMap.put(\"userIdType\", \"1\"); reqMap.put(\"userId\", \"144***50\"); reqMap.put(\"ts\", \"174***64\"); // 待加签的字符串 String str = buildSortedSignData(reqMap); // 加签的字符串 String sign = signWithRSA(str.getBytes(StandardCharsets.UTF_8), privateKey); reqMap.put(\"sign\", sign); System.out.println(\"加签结果：\" + sign); } /** * 生成待签名的字符串 * * @param params 入参 * @return 待签名的字符串 */ public static String buildSortedSignData(Map<String, String> params) throws UnsupportedEncodingException { StringBuilder targetParamStr = new StringBuilder(); Map<String, String> sortedParamMap = new TreeMap<>(params); for (Map.Entry<String, String> param : sortedParamMap.entrySet()) { String key = param.getKey(); String value = param.getValue(); targetParamStr.append(key) .append(\"=\") .append(null == value ? \"\" : URLEncoder.encode(value, \"UTF-8\")) .append(\"&\"); } return targetParamStr.substring(0, targetParamStr.toString().length() - 1); } /** * 签名结果 * * @param data 待签名的字符串 * @param privateKey 私钥 * @return 签名结果 */ public static String signWithRSA(byte[] data, String privateKey) throws Exception { byte[] keyBytes = Base64.decodeBase64(privateKey); PKCS8EncodedKeySpec pkcs8KeySpec = new PKCS8EncodedKeySpec(keyBytes); KeyFactory keyFactory = KeyFactory.getInstance(\"RSA\"); PrivateKey privateK = keyFactory.generatePrivate(pkcs8KeySpec); Signature signature = Signature.getInstance(\"SHA256WithRSA/PSS\"); signature.initSign(privateK); signature.update(data); return Base64.encodeBase64String(signature.sign()); } }"
