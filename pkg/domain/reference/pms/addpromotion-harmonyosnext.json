  "examples": [
    {
      "section": "请求示例",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-addpromotion-harmonyosnext-0000002131508856#section19934722144316",
      "text": "请求示例\n\n以API Client为例：\n\nPOST https://connect-api.cloud.huawei.com/api/pms/product-price-service/v2/manage/product/promotion \nContent-Type: application/json \nclient_id: *** \nAuthorization: Bearer *** \nappId: 1000001 \n{ \n    \"requestId\": \"123\", \n    \"resource\": { \n        \"productNo\": \"productNo10000004\", \n        \"startDate\": 1975010662000, \n        \"endDate\": 1975269862000, \n        \"status\": \"active\", \n        \"strategy\": \"introductory\", \n        \"promotionTitle\": \"postman创建13535\", \n        \"defaultLocale\": \"zh-CN\", \n        \"country\": \"CN\", \n        \"currency\": \"CNY\", \n        \"promotionType\": 4, \n        \"promotionDesc\": \"default desc\", \n        \"defaultPrice\": \"50\", \n        \"languages\": [{ \n            \"title\": \"qewr\", \n            \"locale\": \"en-GB\", \n            \"desc\": \"default desc\" \n        }, { \n            \"title\": \"postman创建13535\", \n            \"locale\": \"zh-CN\", \n            \"desc\": \"default desc\" \n        }], \n        \"prices\": [{ \n            \"country\": \"EG\", \n            \"price\": \"500\" \n        }, { \n            \"country\": \"CN\", \n            \"price\": \"50\" \n        }] ,\n        \"betweenOffersNumOfUnits\": 5,\n        \"betweenOffersPeriodUnit\": \"M\"\n    } \n}"
    },
    {
      "section": "响应示例",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-addpromotion-harmonyosnext-0000002131508856#section280984212013",
      "text": "响应示例\n{\n    \"error\": {\n        \"errorCode\": 0,\n        \"errorMsg\": \"create product promotion success\"\n    },\n    \"promotionId\": \"11CECEC1B2F842A09E6F9F83BA1A1A5E\"\n}"
    }
