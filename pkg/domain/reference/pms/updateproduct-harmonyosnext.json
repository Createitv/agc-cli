      "text": "请求示例\n\n以API Client为例：\n\nPUT https://connect-api.cloud.huawei.com/api/pms/product-price-service/v2/manage/product \nContent-Type: application/json \nclient_id: *** \nAuthorization: Bearer *** \nappId: 1000001 \n \n{ \n    \"requestId\": \"8700018795\", \n    \"resource\": { \n        \"productNo\": \"manageproductput5\", \n        \"appId\": \"30140205131\", \n        \"productName\": \"创建商品定义信息1000002\", \n        \"purchaseType\": \"consumable\", \n        \"status\": \"inactive\", \n        \"defaultPrice\": \"1000002\", \n        \"currency\": \"CNY\", \n        \"country\": \"CN\", \n        \"defaultLocale\": \"zh-CN\", \n        \"productDesc\": \"测试商品描述1000002\", \n        \"languages\": [{ \n            \"locale\": \"zh_CN\", \n            \"productName\": \"创建商品定义信息1000002\", \n            \"productDesc\": \"测试商品描述1000002\" \n        }], \n        \"reviewResourceId\": \"22AA702C947A42A7AF059779D18E872A\",\n        \"reviewPath\": \"我的-会员中心-黄金会员\",\n        \"reviewNote\": \"新建商品\",\n        \"taxIncluded\": 1,\n        \"salesCountry\": [\n            \"LK\",\"TW\",\"TJ\",\"TH\",\"TR\",\"TM\",\"AE\",\"UZ\",\"VN\",\"YE\",\"MN\",\"MM\",\"NP\",\"OM\",\"PK\",\"PS\",\"PH\",\n            \"QA\",\"SA\",\"SG\",\"KZ\",\"KW\",\"KG\",\"LA\",\"LB\",\"MO\",\"MY\",\"MV\",\"CN\",\"CY\",\"GE\",\"HK\",\"ID\",\"IQ\",\n            \"IL\",\"JP\",\"JO\",\"AM\",\"AZ\",\"BH\",\"BD\",\"BN\",\"KH\",\"SL\",\"ZA\",\"TZ\",\"TG\",\"TN\",\"UG\",\"ZM\",\"ZW\",\n            \"MR\",\"MU\",\"YT\",\"MA\",\"MZ\",\"NA\",\"NE\",\"NG\",\"RE\",\"RW\",\"ST\",\"SN\",\"GM\",\"GH\",\"GN\",\"GW\",\"KE\",\n            \"LS\",\"LR\",\"LY\",\"MG\",\"MW\",\"ML\",\"KM\",\"CG\",\"CD\",\"CI\",\"DJ\",\"EG\",\"GQ\",\"ER\",\"SZ\",\"ET\",\"GA\",\n            \"DZ\",\"AO\",\"BJ\",\"BW\",\"BF\",\"CM\",\"CV\",\"CF\",\"TD\",\"PA\",\"PY\",\"PE\",\"PR\",\"LC\",\"TT\",\"UY\",\"VE\",\n            \"GD\",\"GP\",\"GT\",\"GY\",\"HT\",\"HN\",\"JM\",\"MX\",\"NI\",\"CA\",\"KY\",\"CL\",\"CO\",\"CR\",\"DO\",\"