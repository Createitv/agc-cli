  "notes": [
    {
      "section": "功能介绍",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-respackapi-addversion-0000002328396224#section8711909",
      "text": "创建“使用华为CDN”方式的资源包预下载任务。"
    },
    {
      "section": "请求参数",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-respackapi-addversion-0000002328396224#section985411610234",
      "text": "GWOpAddPackageVersionReq 参数名称 必选(M)/可选(O) 类型 参数说明 resourceVersion O GWOpPackageVersion 资源包版本信息。 GWOpPackageVersion 参数名称 必选(M)/可选(O) 类型 参数说明 packageName O String 游戏包名。最大长度255个字符。 appId M String 游戏APP ID，获取方法参考查询应用信息。 version M Int 资源包版本号。要求是不超过9位的整数，且必须大于已创建任务的版本号。 startTime M Long 资源包预下载日期的开始时间。 endTime M Long 资源包预下载日期的结束时间。"
    },
    {
      "section": "请求参数",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-respackapi-addversion-0000002328396224#section985411610234",
      "text": "GWOpPackageVersion 参数名称 必选(M)/可选(O) 类型 参数说明 packageName O String 游戏包名。最大长度255个字符。 appId M String 游戏APP ID，获取方法参考查询应用信息。 version M Int 资源包版本号。要求是不超过9位的整数，且必须大于已创建任务的版本号。 startTime M Long 资源包预下载日期的开始时间。 endTime M Long 资源包预下载日期的结束时间。"
    },
    {
      "section": "响应参数",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-respackapi-addversion-0000002328396224#section49198053",
      "text": "GbasRet 参数名称 必选(M)/可选(O) 类型 参数说明 code O Int 返回码，请参见错误码。 msg O String 返回码描述信息。"
    },
    {
      "section": "响应参数",
      "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-respackapi-addversion-0000002328396224#section49198053",
      "text": "GWOpPackageVersionRspData 参数名称 必选(M)/可选(O) 类型 参数说明 versionId O Long 资源包版本ID。"
    }
  ],
