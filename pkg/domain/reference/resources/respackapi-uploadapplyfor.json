      "text": "响应示例\n{\n    \"ret\": {\n        \"code\": 0,\n        \"msg\": \"success\"\n    },\n    \"data\": {\n        \"fileId\": \"1734842730388976000\",\n        \"uploadTime\": 0,\n        \"filePartUploadInfos\": [\n        {\n            \"partNo\": \"20\",\n            \"partObjectId\": \"string\",\n            \"uploadInfo\": {\n                \"uploadMethod\": \"POST\",\n                \"uploadUrl\": \"https://contentcenter-test-bj4-001.obs.dualstack.cn-north-4.mycloud.cn/GameCenter_resourcePackage_900_9/6f/v3/xxxx.mp4\",\n                \"uploadHeaders\": [\n                {\n                    \"key\": \"Content-Type\",\n                    \"value\": \"video/mp4\"\n                }\n              ]\n           }\n        }\n      ]\n   }\n}"
    }
