[
  {
    "name": "client_id",
    "type": "string",
    "required": false,
    "description": "客户端ID，获取方法参考获取客户端API授权。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/client-rest-auth-verifycode-0000001294228992#section16132444182317",
    "in": "header"
  },
  {
    "name": "Authorization",
    "type": "string",
    "required": false,
    "description": "认证信息，格式为“Authorization: Bearer ${access_token}”。access_token为获取Token中获取的access_token。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/client-rest-auth-verifycode-0000001294228992#section16132444182317",
    "in": "header"
  },
  {
    "name": "productId",
    "type": "string",
    "required": true,
    "description": "项目ID，查询方法可参见查询项目ID。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/client-rest-auth-verifycode-0000001294228992#section228117246513",
    "in": "query"
  },
  {
    "name": "phone",
    "type": "string",
    "required": false,
    "description": "手机号。需包含国家码，以“+”开头，国家码和手机号之间以“-”连接，例如中国大陆手机号“+86-150xxxxxxxx”。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/client-rest-auth-verifycode-0000001294228992#section31763842416",
    "in": "body"
  },
  {
    "name": "email",
    "type": "string",
    "required": false,
    "description": "电子邮箱。 电子邮箱和手机号码二者必填一个。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/client-rest-auth-verifycode-0000001294228992#section31763842416",
    "in": "body"
  },
  {
    "name": "action",
    "type": "integer",
    "required": false,
    "description": "验证码行为，取值如下： 1001：注册登录时申请验证码。 1002：重置密码时申请验证码。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/client-rest-auth-verifycode-0000001294228992#section31763842416",
    "in": "body",
    "enum": [
      "1001",
      "1002"
    ]
  },
