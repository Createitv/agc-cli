    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-addadkpexport-0000001111845102#section886219295206"
  },
  {
    "name": "endTime",
    "in": "query",
    "type": "string",
    "required": true,
    "description": "查询结束时间，UTC时间，格式为YYYYMMDD。startTime和endTime之间不超过180天。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-addadkpexport-0000001111845102#section886219295206"
  },
  {
    "name": "userTag",
    "in": "query",
    "type": "integer",
    "required": false,
    "description": "基于账号还是设备查询。 取值范围： 0: 账号 1: 设备 默认值：1",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-addadkpexport-0000001111845102#section886219295206",
    "enum": [
      "0",
      "1"
    ]
  },
  {
    "name": "exportType",
    "in": "query",
    "type": "string",
    "required": false,
    "description": "导出文件类型。 取值范围： CSV：导出CSV文件格式 EXCEL：导出Excel文件格式 默认值：CSV",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-addadkpexport-0000001111845102#section886219295206",
