[
  {
    "name": "appId",
    "in": "query",
    "type": "string",
    "required": true,
    "description": "应用ID，获取方法参考查询应用信息。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-com-rating-0000001133889426#section1268762644313"
  },
  {
    "name": "beginTime",
    "in": "query",
    "type": "integer",
    "required": true,
    "description": "开始时间的时间戳，从1970/01/01 08:00:00开始计算的毫秒数。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-com-rating-0000001133889426#section1268762644313",
    "format": "int64"
  },
  {
    "name": "endTime",
    "in": "query",
    "type": "integer",
    "required": true,
    "description": "结束时间的时间戳，从1970/01/01 08:00:00开始计算的毫秒数。 beginTime和endTime不能超过6个月的跨度。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-com-rating-0000001133889426#section1268762644313",
    "format": "int64"
  },
  {
    "name": "countries",
    "in": "query",
    "type": "string",
    "required": true,
    "description": "ISO国家码（例如：CN），多个国家码使用英文逗号分隔，但一次只能查询同一站点内的国家。取值请参考国家码。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-com-rating-0000001133889426#section1268762644313"
  },
  {
    "name": "apkVersions",
    "in": "query",
    "type": "string",
    "required": false,
    "description": "应用版本（例：a.b.c），为应用市场中应用显示的版本号。该参数不设置时默认查询所有版本的评论内容，否则请设置具体版本，查询多个版本的评论内容时使用英文逗号分隔。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-com-rating-0000001133889426#section1268762644313"
  },
  {
    "name": "ratings",
    "in": "query",
    "type": "string",
    "required": false,
    "description": "评分（1~5），该参数不设置时默认查询所有评分的评论内容，否则请设置具体评分，查询多个评分的评论内容时使用英文逗号分隔。 例如： 如果传递参数“5”为查询所有评分为5的评论。 如果传递参数“4,5”为查询所有评分为4和5的评论。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-com-rating-0000001133889426#section1268762644313"
  },
  {
    "name": "sort",
    "in": "query",
    "type": "integer",
    "required": false,
    "description": "排序方式，默认值：0。 0：BYTIME，按时间排序。 1：BYSCOREDESC，按分数降序。 2：BYSCOREASC，按分数排序。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-com-rating-0000001133889426#section1268762644313",
    "enum": [
      "0",
      "1",
      "2"
    ]
  },
  {
    "name": "page",
    "in": "query",
    "type": "integer",
    "required": false,
    "description": "请求查询的页码，默认1。 例如，查询时page配置为2，limit配置为20，表示返回时每页显示20条评论数据，当前查询第2页。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-com-rating-0000001133889426#section1268762644313"
  },
  {
    "name": "limit",
    "in": "query",
    "type": "integer",
    "required": false,
    "description": "每页请求数目，最大100条每页，默认50条。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-com-rating-0000001133889426#section1268762644313",
    "maximum": 100
  }
]
