    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/clouddb-signin-rest-0000001496447669#section1643221416579",
    "in": "body"
  },
  {
    "name": "aaId",
    "type": "string",
    "required": false,
    "description": "应用实例唯一编号。",
