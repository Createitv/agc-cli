[
  {
    "name": "teamId",
    "in": "header",
    "type": "string",
    "required": false,
    "description": "开发者所在团队的团队ID，可通过获取团队列表接口获取。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-0000001158245061#section236517415165"
  },
  {
    "name": "appId",
    "in": "query",
    "type": "string",
    "required": true,
    "description": "应用ID。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-0000001158245061#section292816392364"
  },
  {
    "name": "releaseTime",
    "in": "query",
    "type": "string",
    "required": false,
    "description": "指定发布的UTC时间格式：yyyy-MM-ddTHH:mm:ssZZ，例如“2015-01-01T01:01:01+0800”。 说明 如果releaseTime未填写，应用审核通过后会立即上架。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-0000001158245061#section292816392364"
  },
  {
    "name": "remark",
    "in": "query",
    "type": "string",
    "required": false,
    "description": "提审发布的备注信息，可以为空。如果填写，长度范围在10-300。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-0000001158245061#section292816392364"
  },
  {
    "name": "releaseType",
    "in": "query",
    "type": "integer",
    "required": false,
    "description": "应用发布方式。 取值范围： 1：全网 3：分阶段 说明 应用发布方式为分阶段发布时，要求该应用存在一个已上架的版本。 默认值：1",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-0000001158245061#section292816392364",
    "enum": [
      "1",
      "3"
    ]
  },
  {
    "name": "state",
    "in": "body",
    "type": "string",
    "required": false,
    "description": "此参数无需设置。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-0000001158245061#section11431111271820"
  },
  {
    "name": "phasedReleaseStartTime",
    "in": "body",
    "type": "string",
    "required": false,
    "description": "分阶段发布生效开始时间，UTC时间格式：yyyy-MM-ddTHH:mm:ssZZ，例如“2015-01-01T01:01:01+0800”。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-0000001158245061#section11431111271820",
    "maxLength": 64
  },
  {
    "name": "phasedReleaseEndTime",
    "in": "body",
    "type": "string",
    "required": false,
    "description": "分阶段发布生效结束时间，UTC时间格式：yyyy-MM-ddTHH:mm:ssZZ，例如“2015-01-01T01:01:01+0800”。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-0000001158245061#section11431111271820",
    "maxLength": 64
  },
  {
    "name": "phasedReleasePercent",
    "in": "body",
    "type": "string",
    "required": false,
    "description": "分阶段发布百分比。 Android应用取值范围为0.00到100.00，必须精确到两位小数，不含百分号。 HarmonyOS应用取值为0.00到100.00，可以不带小数或只带一位小数，不含百分号。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-0000001158245061#section11431111271820",
    "maxLength": 10
  },
  {
    "name": "phasedReleaseDescription",
    "in": "body",
    "type": "string",
    "required": false,
    "description": "分阶段发布说明。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-0000001158245061#section11431111271820",
    "maxLength": 500
  },
  {
    "name": "isPureDetection",
    "in": "body",
    "type": "integer",
    "required": false,
    "description": "是否申请绿色应用认证。 取值范围： 0：否 1：是",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-0000001158245061#section11431111271820",
    "enum": [
      "0",
      "1"
    ]
  },
  {
    "name": "sensitivePermissionIconUrl",
    "in": "body",
    "type": "string",
    "required": false,
    "description": "绿色认证审核材料的objectId，isPureDetection=1时为必填项。该值为将绿色认证审核材料打成zip包，然后先调用获取上传文件地址接口，然后调用上传文件接口上传审核材料，最后得到获取上传文件地址接口返回的objectId。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-0000001158245061#section11431111271820"
  },
  {
    "name": "isCommitSensitivePermissionTips",
    "in": "body",
    "type": "boolean",
    "required": false,
    "description": "确认是否符合相关要求，true表示符合。isPureDetection=1时为必填项，且只可以填true。要求包括： 非必要的使用场景禁止桌面、锁屏和其他应用弹出窗口骚扰用户行为。 非必要的使用场景禁止发送无法删除的常驻通知。 禁止影响用户体验的广告，如抬头、强制插屏、侧边等。 禁止引导用户开启开发者选项。 禁止引导用户开启USB调试模式。 禁止通过热补丁，引入恶意行为和不符合以上条款的行为。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-0000001158245061#section11431111271820"
  }
]
