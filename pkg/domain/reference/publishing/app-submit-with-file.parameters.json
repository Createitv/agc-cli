[
  {
    "name": "teamId",
    "in": "header",
    "type": "string",
    "required": false,
    "description": "开发者所在团队的团队ID，可通过获取团队列表接口获取。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-with-file-0000001111845092#section236517415165"
  },
  {
    "name": "appId",
    "in": "query",
    "type": "string",
    "required": true,
    "description": "应用ID。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-with-file-0000001111845092#section5528235174214"
  },
  {
    "name": "releaseTime",
    "in": "body",
    "type": "string",
    "required": false,
    "description": "指定发布时间，如果为空表示审核通过立即上架。UTC时间：yyyy-MM-ddTHH:mm:ssZZ，例如“2015-01-01T01:01:01+0800”。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-with-file-0000001111845092#section15344132481910",
    "maxLength": 64
  },
  {
    "name": "remark",
    "in": "body",
    "type": "string",
    "required": false,
    "description": "提交发布的备注信息，可以为空，如果填写，长度范围在10-300。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-with-file-0000001111845092#section15344132481910",
    "maxLength": 300
  },
  {
    "name": "releaseType",
    "in": "body",
    "type": "integer",
    "required": false,
    "description": "发布方式。 取值范围： 1：全网。 3：分阶段。 默认值：1",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-with-file-0000001111845092#section15344132481910",
    "enum": [
      "1",
      "3"
    ]
  },
  {
    "name": "downloadUrl",
    "in": "body",
    "type": "string",
    "required": true,
    "description": "由您提供的软件包下载地址，支持APK/RPK/AAB/EXE等。 APK：不超过4GB。 RPK：快应用不超过20MB，快游戏不超过30MB。 AAB：不超过150MB。 EXE（Windows应用）: 不超过4GB。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-with-file-0000001111845092#section15344132481910"
  },
  {
    "name": "downloadFileName",
    "in": "body",
    "type": "string",
    "required": true,
    "description": "downloadUrl下载地址中下载的文件名，包括后缀。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-with-file-0000001111845092#section15344132481910",
    "maxLength": 64
  },
  {
    "name": "callbackAddr",
    "in": "body",
    "type": "string",
    "required": false,
    "description": "应用发布回调地址，由您自行配置。应用发布结果由华为服务器调用回调结果通知接口通过该URL回调给您的开发者服务器。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-with-file-0000001111845092#section15344132481910"
  },
  {
    "name": "requestId",
    "in": "body",
    "type": "string",
    "required": true,
    "description": "您自定义的请求字符串，必须唯一标识此请求。结果回调时会携带该字段。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-with-file-0000001111845092#section15344132481910"
  },
  {
    "name": "clearArk",
    "in": "body",
    "type": "string",
    "required": false,
    "description": "是否清除方舟包（用于Android + 方舟升级到Android）。 取值范围： 1：需要清除方舟包。 0：不需要清除方舟包。 默认值：0。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-with-file-0000001111845092#section15344132481910"
  },
  {
    "name": "sensitivePermissionDesc",
    "in": "body",
    "type": "string",
    "required": false,
    "description": "敏感信息。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-with-file-0000001111845092#section15344132481910"
  },
  {
    "name": "phasedReleaseInfo",
    "in": "body",
    "type": "object",
    "required": false,
    "description": "分阶段发布信息。releaseType为3时，此参数必选。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-with-file-0000001111845092#section15344132481910",
    "properties": [
      {
        "name": "state",
        "in": "body",
        "type": "string",
        "required": false,
        "description": "此参数无需设置。",
        "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-with-file-0000001111845092#section15344132481910"
      },
      {
        "name": "phasedReleaseStartTime",
        "in": "body",
        "type": "string",
        "required": true,
        "description": "分阶段发布生效开始时间，UTC时间格式：yyyy-MM-ddTHH:mm:ssZZ，例如“2015-01-01T01:01:01+0800”。",
        "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-with-file-0000001111845092#section15344132481910",
        "maxLength": 64
      },
      {
        "name": "phasedReleaseEndTime",
        "in": "body",
        "type": "string",
        "required": true,
        "description": "分阶段发布生效结束时间，UTC时间格式：yyyy-MM-ddTHH:mm:ssZZ，例如“2015-01-01T01:01:01+0800”。",
        "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-with-file-0000001111845092#section15344132481910",
        "maxLength": 64
      },
      {
        "name": "phasedReleasePercent",
        "in": "body",
        "type": "string",
        "required": true,
        "description": "分阶段发布百分比，取值范围为0.00到100.00，必须精确到两位小数，不含百分号。",
        "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-with-file-0000001111845092#section15344132481910",
        "maxLength": 10
      },
      {
        "name": "phasedReleaseDescription",
        "in": "body",
        "type": "string",
        "required": true,
        "description": "分阶段发布说明。",
        "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-with-file-0000001111845092#section15344132481910",
        "maxLength": 500
      }
    ]
  },
  {
    "name": "versionName",
    "in": "body",
    "type": "string",
    "required": false,
    "description": "Windows应用的软件包版本号。 文件类型为exe软件包时必选。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-with-file-0000001111845092#section15344132481910"
  },
  {
    "name": "displayName",
    "in": "body",
    "type": "string",
    "required": false,
    "description": "注册表显示名称，用于唯一标识Windows用。 文件类型为exe软件包时必选。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-with-file-0000001111845092#section15344132481910"
  },
  {
    "name": "isPureDetection",
    "in": "body",
    "type": "integer",
    "required": false,
    "description": "是否申请绿色应用认证。 取值范围： 0：否 1：是",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-with-file-0000001111845092#section15344132481910",
    "enum": [
      "0",
      "1"
    ]
  },
  {
    "name": "sensitivePermissionIconUrl",
    "in": "body",
    "type": "string",
    "required": false,
    "description": "绿色认证审核材料的objectId，isPureDetection=1时为必填项。该值为将绿色认证审核材料打成zip包，然后先调用获取上传文件地址接口，然后调用上传文件接口上传审核材料，最后得到获取上传文件地址接口返回的objectId。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-with-file-0000001111845092#section15344132481910"
  },
  {
    "name": "isCommitSensitivePermissionTips",
    "in": "body",
    "type": "boolean",
    "required": false,
    "description": "是否确认符合相关要求，true表示符合。isPureDetection=1时为必填项，且只可以填true。要求包括： 非必要的使用场景禁止桌面、锁屏和其他应用弹出窗口骚扰用户行为。 非必要的使用场景禁止发送无法删除的常驻通知。 禁止影响用户体验的广告，如抬头、强制插屏、侧边等。 禁止引导用户开启开发者选项。 禁止引导用户开启USB调试模式。 禁止通过热补丁，引入恶意行为和不符合以上条款的行为。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-submit-with-file-0000001111845092#section15344132481910"
  }
]
