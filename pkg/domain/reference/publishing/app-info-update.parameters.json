    "maxLength": 256
  },
  {
    "name": "registeredDclType",
    "in": "body",
    "type": "integer",
    "required": false,
    "description": "APP类型信息。 取值范围： -1：清空APP类型信息 0：APP服务器在中国大陆 1：APP服务器不在中国大陆 2：APP为单机APP",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-info-update-0000001111685198#section17512144171520",
    "enum": [
      "-1",
      "0",
      "1",
      "2"
    ]
  },
  {
    "name": "registeredIdType",
    "in": "body",
    "type": "integer",
    "required": false,
    "description": "主办单位类型。 取值范围： -1：清空数据（会联动清空registeredIdNumber的内容） 1：企业（社会信用代码） 2：个人（身份证号码） 3：机构（机构代码）",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-info-update-0000001111685198#section17512144171520",
    "enum": [
      "-1",
      "1",
      "2",
      "3"
    ]
  },
  {
    "name": "registeredIdNumber",
    "in": "body",
    "type": "string",
    "required": false,
    "description": "主办单位证件号。 取值范围： registeredIdType为1时，对应统一社会信用代码 registeredIdType为2时，对应身份证号码 registeredIdType为3时，对应组织机构代码",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-info-update-0000001111685198#section17512144171520",
    "maxLength": 64
  },
  {
    "name": "registeredEntity",
    "in": "body",
    "type": "integer",
    "required": false,
    "description": "主办单位。 取值范围： 1：与开发者账号主体一致 2：与开发者账号主体不一致 说明 当registeredDclType值为0（APP服务器在中国大陆）时，该字段必填。若不填写或填写错误，会导致审核不通过。 若在版本提交时，该字段值选择“一致”，则主办单位名称和证件号，将直接复用开发者联盟注册账号信息。 若您提交的主办单位信息与联盟账号信息不一致，该字段值却选择了“一致”，则系统将自动判定为“不一致”，将会影响审核结果。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-info-update-0000001111685198#section17512144171520",
    "enum": [
      "1",
      "2"
    ]
  },
  {
    "name": "registeredEntityName",
    "in": "body",
    "type": "string",
    "required": false,
    "description": "主办单位名称。 说明 当registeredDclType值为0（APP服务器在中国大陆）时，该字段必填。若不填写或填写错误，会导致审核不通过。",
    "sourceUrl": "https://developer.huawei.com/consumer/cn/doc/AppGallery-connect-References/agcapi-app-info-update-0000001111685198#section17512144171520",
    "maxLength": 1024
  },
