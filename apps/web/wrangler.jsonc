{
  "name": "agc-cli-site",
  "main": "./worker.js",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "agccli.app",
      "custom_domain": true
    }
  ]
}
