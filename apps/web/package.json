{
  "name": "agc-cli-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "registry:generate": "node scripts/export-registry.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build && node scripts/prerender.mjs",
    "test": "vitest --environment jsdom",
    "deploy:cloudflare": "npm run build && npx wrangler@latest deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^24.1.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
